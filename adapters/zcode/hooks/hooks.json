{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/dist/hooks/zcode.js", "session-start"],
            "timeoutMs": 10000,
            "statusMessage": "egress-eye: start session"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/dist/hooks/zcode.js", "pre-tool-use", "${CLAUDE_SESSION_ID}"],
            "timeoutMs": 15000,
            "statusMessage": "egress-eye: inspect tool call"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/dist/hooks/zcode.js", "post-tool-use-failure", "${CLAUDE_SESSION_ID}"],
            "timeoutMs": 15000,
            "statusMessage": "egress-eye: record failed call"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/dist/hooks/zcode.js", "stop", "${CLAUDE_SESSION_ID}"],
            "timeoutMs": 15000,
            "statusMessage": "egress-eye: session report"
          }
        ]
      }
    ]
  }
}
